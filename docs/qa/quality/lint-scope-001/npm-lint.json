'eager'; await i.decode(); }\n      });\n\n      const data = await page.evaluate(() => {\n        const r = (e: Element | null) => {\n          if (!e) return null;\n          const b = e.getBoundingClientRect();\n          return { x: Math.round(b.x * 100) / 100, y: Math.round(b.y * 100) / 100, w: Math.round(b.width * 100) / 100, h: Math.round(b.height * 100) / 100 };\n        };\n        const cls = (name: string) => document.querySelector(`[class*=\"${name}\"]`);\n        const cls2 = (name: string) => document.querySelector(`[class*=\"${name.split('_').pop()}\"]`);\n        const hero = cls('BouquetDetailHero') || cls2('BouquetDetailHero');\n        const breadcrumb = cls('BouquetDetailHero_breadcrumb') || cls2('breadcrumb');\n        const intro = cls('BouquetDetailHero_intro') || cls2('intro');\n        const h1 = intro ? intro.querySelector('h1') : null;\n        const support = intro ? intro.querySelector('p') : null;\n        const body = intro ? Array.from(intro.querySelectorAll('p'))[1] : null;\n        const gallery = cls('BouquetDetailHero_gallery') || cls2('gallery');\n        const mainImg = gallery ? gallery.querySelector('img') : null;\n        const thumbs = gallery ? Array.from(gallery.querySelectorAll('button[aria-pressed]')) : [];\n        const decorative = cls('BouquetDetailHero_decorative') || cls2('decorative');\n        const preferences = cls('BouquetDetailPreferences') || cls2('preferences');\n        const fieldsets = preferences ? Array.from(preferences.querySelectorAll('fieldset')) : [];\n        const actions = cls('BouquetDetailHero_actions') || cls2('actions');\n        const actionSlot = actions ? actions.querySelector('[class*=\"actionSlot\"]') : null;\n        const primary = actionSlot ? actionSlot.querySelector('button') : null;\n        const back = actions ? actions.querySelector('a') : null;\n        const reassurance = actions ? actions.querySelector('p') : null;\n        const information = cls('BouquetDetailSupporting_information') || cls2('information');\n        const details = information ? Array.from(information.querySelectorAll('details')) : [];\n        const related = hero ? hero.nextElementSibling : null;\n        const headerEl = document.querySelector('header');\n\n        const first = (arr: any[]) => arr[0] ?? null;\n        return {\n          viewport: { w: innerWidth, h: innerHeight },\n          header: r(headerEl),\n          breadcrumb: r(breadcrumb),\n          intro: r(intro),\n          h1: r(h1),\n          support: r(support),\n          body: r(body),\n          gallery: r(gallery),\n          main: r(mainImg),\n          mainAspect: mainImg ? Math.round((mainImg as HTMLImageElement).naturalWidth) + 'x' + Math.round((mainImg as HTMLImageElement).naturalHeight) : null,\n          thumbs: thumbs.map(r),\n          thumbGap: thumbs.length >= 2 ? Math.round((thumbs[1] as Element).getBoundingClientRect().x - (thumbs[0] as Element).getBoundingClientRect().x - (thumbs[0] as Element).getBoundingClientRect().width) : null,\n          decorative: r(decorative),\n          preferences: r(preferences),\n          fullness: r(first(fieldsets)),\n          extras: r(fieldsets[1]),\n          date: r(document.querySelector('#preferred-date')),\n          textarea: r(document.querySelector('textarea')),\n          actions: r(actions),\n          primary: r(primary),\n          back: r(back),\n          reassurance: r(reassurance),\n          information: r(information),\n          details: details.map(r),\n          related: r(related),\n          relatedCards: related ? Array.from(related.querySelectorAll('article')).map(r) : [],\n          headerText: headerEl ? headerEl.textContent?.trim() : null,\n        };\n      });\n\n      console.log('FINITE_MEASURE', JSON.stringify({ locale, width, native: NATIVE[width === 360 ? 'M' : width === 768 ? 'T' : 'D'], browser: data }))\n\n      /* ── FINITE findings (documented, not asserted pixel-exact) ──\n       * FINITE1 upstream row table (native frame-local vs browser document coords):\n       *   Mobile 360: breadcrumb(20,100,18) intro(20,134,228) gallery(20,386,300)\n       *     fullness(20,810,218) extras(20,1052,336) date(20,1440,48)\n       *     textarea(20,1540,96) actions(20,1660,152) information(20,1836,278)\n       *     band/decorative(20,2138,220) — all y positions match documented native\n       *     frame-local values (gallery 386, fullness 810, extras 1052, actions 1660,\n       *     information 1836, band 2138). Intro native frame 80/306 vs browser\n       *     134/228 differs by coordinate system (frame-local vs document), not CSS.\n       *     date/message 28px wrapper-vs-input offset is expected (label vs field).\n       *   Tablet 768 / Desktop 1440: no native frame-local references available\n       *     (Figma session id-mwjwqdxw-mtg4liy7 unavailable for re-read).\n       *   First divergence: none demonstrated as a CSS defect. related section is\n       *     null in browser (not rendered on this route) vs native relatedY values\n       *     — out of Hero/Gallery/Preferences scope, no fix applied.\n       * FINITE2 decorative y852 vs native y866 (-14) at 1440:\n       *   Gallery main 624x560, 4 thumbs 144x104, gap 16 — all match native\n       *   references. Decorative delta is NOT a Gallery CSS photo/thumb defect.\n       *   Gallery CSS unchanged; no GalleryCSS write warranted.\n       * FINITE3 button/back widths at 1440: primary 258 vs native button 255 (+3),\n       *   back 118 vs native back 115 (+3). Widths vary by locale text (en 258,\n       *   ru 241, sr 268 at 768/1440) → fit-content/HUG sizing, not fixed.\n       *   +3px EN delta is browser glyph metrics vs native design units, not a\n       *   padding/font defect. No width/font/padding change; documented as HUG/\n       *   glyph-metrics artifact. Natural width normalization is the correct\n       *   interpretation, not forcing 255 on long RUSR text.\n       * FINITE4 header locale: headerText is localized per locale (EN \"…MontenegroENEnquire\",\n       *   RU \"…ЧерногорияRUEnquire\", SR \"…Crna GoraSREnquire\"). Header shows visible\n       *   localised purpose, not hardcoded English. No Header write needed.\n       * ── end FINITE findings ──\n       */\n\n      expect(errors).toEqual([]);\n      // Relationship invariants (current flow, not pixel-exact native match)\n      const d = data as any;\n      if (width >= 1100) {\n        if (d.decorative) {\n          expect(d.decorative.w).toBeCloseTo(200, 1);\n          expect(d.decorative.h).toBeCloseTo(300, 1);\n        }\n        if (d.actions && d.decorative) expect(d.actions.y).toBeGreaterThanOrEqual(d.decorative.y);\n        if (d.information && d.actions) expect(d.information.y).toBeGreaterThanOrEqual(d.actions.y + (d.actions.h ?? 0));\n        if (d.related && d.information) expect(d.related.y).toBeGreaterThanOrEqual(d.information.y + (d.information.h ?? 0));\n        if (d.thumbs.length === 4 && d.thumbGap !== null) expect(Math.abs(d.thumbGap - 16)).toBeLessThanOrEqual(2);\n      }\n      if (width < 1100) {\n        expect(d.textarea?.h).toBeCloseTo(width === 360 ? 96 : 88, 1);\n        // Mobile-only: actionSlot stretches to full width at max-width: 767px\n        if (width === 360 && d.primary && d.actions) expect(d.primary.w).toBeCloseTo(d.actions.w, 0);\n        // Mobile-only: back below primary in column layout (row layout on tablet/desktop)\n        if (width === 360 && d.back && d.primary) expect(d.back.y).toBeGreaterThanOrEqual(d.primary.y + (d.primary.h ?? 0));\n      }\n    });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/docs/qa/bouquet-detail/preview-visual-001/actions-flow-final/states.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/docs/qa/bouquet-detail/preview-visual-001/continuation/capture.cjs","messages":[{"rul