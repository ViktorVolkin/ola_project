    "test:feature": "node scripts/qa/suites.mjs",
    "test:full": "node scripts/qa/suites.mjs full",
    "test:inventory": "node scripts/qa/suites.mjs inventory",
    "check:quick": "npm run test:unit && npm run test:smoke",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:full",
